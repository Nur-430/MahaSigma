<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tasks_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MahaSigma // Deadline Terdekat"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_tasks_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_chip"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="0 Tugas"
            android:textColor="#E0E1DD"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="#2E4057" />

    <!-- Task Item 1 (Most urgent) -->
    <LinearLayout
        android:id="@+id/layout_task_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_widget_item"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_task_1_countdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚨 Hari ini, 23:59"
                android:textColor="#EF4444"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_task_1_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TINGGI"
                android:textColor="#EF4444"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_task_1_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Judul Tugas Terdekat 1"
            android:textColor="#E0E1DD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_task_1_course"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Mata Kuliah • Deskripsi singkat"
            android:textColor="#778DA9"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Task Item 2 -->
    <LinearLayout
        android:id="@+id/layout_task_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_item"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_task_2_countdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ Besok"
                android:textColor="#F59E0B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_task_2_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEDANG"
                android:textColor="#F59E0B"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_task_2_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Judul Tugas Terdekat 2"
            android:textColor="#E0E1DD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_task_2_course"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Mata Kuliah"
            android:textColor="#778DA9"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_widget_tasks_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="✨ Semua deadline beres!\nTidak ada tugas mendesak."
        android:textColor="#10B981"
        android:textSize="11sp"
        android:visibility="visible" />

    <!-- Footer Action -->
    <TextView
        android:id="@+id/btn_widget_open_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Buka Daftar Tugas →"
        android:textColor="#F59E0B"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
